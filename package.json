{
  "name": "world-of-agents",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "hall": "npm run build && tsx server/main.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mod": "claude plugin test plugin",
    "mod:surface": "node scripts/mod-surface.mjs",
    "types:update": "node scripts/types-update.mjs",
    "build:plugin-hall": "tsx scripts/build-plugin-hall.ts",
    "dev:refresh": "node scripts/dev-refresh.mjs",
    "check:hall": "tsx scripts/build-plugin-hall.ts --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:mod && npm run mod:surface",
    "release:check": "npm run check:hall && npm run check"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
