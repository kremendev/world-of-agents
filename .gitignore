# Logs
logs
*.log
npm-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo

# Secrets: v2 uses no API key (observer mode: the plugin's hooks and Claude Code's own login).
# .env stays ignored so a stray secret can never be committed.
.env
.env.*
!.env.example
*.local

# Claude Code writes this beside a mod it loads from this folder (woa's --plugin-dir). It only extends the engine's own
# types in plugin/.claude-plugin/types/, which carry a .gitignore of their own.
plugin/tsconfig.json

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.sw?

# The 3D town (Forge Keep): build output, the stand-in three.js the page walks generate, the render test's copies
town/dist
town/src/module.mjs
town/test/mock/*.js
town/test/mock/names.txt
town/.serve
town/.three160
town/**/__pycache__
