    "state reads": ["world-of-agents.view"],
    "state writes": ["world-of-agents.view"],
    "gating hook without .catch": [
      "agent.spawn",
      "command.run{command=world-of-agents:team}",
      "classic.SubagentStart",
      "classic.UserPromptSubmit",
      "tool.call",
      "tool.check"
