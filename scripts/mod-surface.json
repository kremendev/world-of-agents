{
  "./mod/register.tsx": {
    "hooks": [
      "agent.spawn",
      "classic.SubagentStart",
      "classic.UserPromptSubmit",
      "command.run{command=world-of-agents:team}",
      "session.measure",
      "session.start",
      "tool.call",
      "tool.check",
      "turn.complete",
      "turn.start",
      "ui.render{component=Pane, requestId=world-of-agents}"
    ],
