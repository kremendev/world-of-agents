{
  "permissions": {
    "defaultMode": "default",
    "allow": ["Bash(npm test)", "Bash(npm run check)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Read(~/.world-of-agents/**)",
      "Edit(~/.world-of-agents/**)",
      "Write(~/.world-of-agents/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  }
}
